  "formulas": {
    "sprs_score_calculation": {
      "formula_id": "sprs_score_calculation",
      "model_name": "DoD NIST SP 800-171 v1.2.1 SPRS Summary Score",
      "expression": "110 - (min(44, max(0, missing_5pt)) * 5 + min(14, max(0, missing_3pt)) * 3 + min(51, max(0, missing_1pt)) * 1)",
      "js_expression": "(110 - (((Math.min(44, Math.max(0, missing_5pt)) * 5) + (Math.min(14, Math.max(0, missing_3pt)) * 3)) + (Math.min(51, Math.max(0, missing_1pt)) * 1)))",
      "variables": {
        "missing_5pt": 0,
        "missing_3pt": 0,
        "missing_1pt": 0
      },
      "expected_baseline_output": 110.0,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "Full compliance (110)",
          "inputs": {
            "missing_5pt": 0,
            "missing_3pt": 0,
            "missing_1pt": 0
          },
          "expected": 110.0
        },
        {
          "label": "Zero controls implemented (-203 floor)",
          "inputs": {
            "missing_5pt": 44,
            "missing_3pt": 14,
            "missing_1pt": 51
          },
          "expected": -203.0
        },
        {
          "label": "Conditional POA&M floor (missing 4x5pt + 2x1pt = 88)",
          "inputs": {
            "missing_5pt": 4,
            "missing_3pt": 0,
            "missing_1pt": 2
          },
          "expected": 88.0
        }
      ],
      "citation_keys": [
        "dod_sprs_v121"
      ],
      "allowed_slug_patterns": [
        ".*sprs.*",
        ".*800-171.*",
        ".*cmmc.*"
      ],
      "forbidden_slug_patterns": [],
      "output_selectors": [
        "#sprs-score",
        "[data-output='sprs_score']"
      ]
    },
    "hipaa_tier4_exposure": {
      "formula_id": "hipaa_tier4_exposure",
      "model_name": "2026 HIPAA Tier 4 Annual Statutory Penalty Cap (45 CFR 160.404)",
      "expression": "round(min(2190294.0, max(0, violations_count) * per_violation_penalty), 2)",
      "js_expression": "(Math.round((Math.min(2190294.0, (Math.max(0, violations_count) * per_violation_penalty))) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "violations_count": 40,
        "per_violation_penalty": 71162.0
      },
      "expected_baseline_output": 2190294.0,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "40 uncorrected Tier 4 violations capped at $2,190,294",
          "inputs": {
            "violations_count": 40,
            "per_violation_penalty": 71162.0
          },
          "expected": 2190294.0
        },
        {
          "label": "10 Tier 4 violations below annual cap",
          "inputs": {
            "violations_count": 10,
            "per_violation_penalty": 71162.0
          },
          "expected": 711620.0
        }
      ],
      "citation_keys": [
        "hhs_hipaa_45cfr"
      ],
      "allowed_slug_patterns": [
        ".*hipaa.*"
      ],
      "forbidden_slug_patterns": [],
      "output_selectors": [
        "#hipaa-penalty-exposure",
        "[data-output='hipaa_exposure']"
      ]
    },
    "soc2_type2_total_budget": {
      "formula_id": "soc2_type2_total_budget",
      "model_name": "SOC 2 Type II Total Scoping Budget Estimate (BLS Loaded Rate)",
      "expression": "round(cpa_base_fee + (extra_tsc_count * fee_per_extra_tsc) + grc_platform_annual + pentest_fee + (remediation_hours * 121.67), 2)",
      "js_expression": "(Math.round(((((cpa_base_fee + (extra_tsc_count * fee_per_extra_tsc)) + grc_platform_annual) + pentest_fee) + (remediation_hours * 121.67)) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "cpa_base_fee": 28000.0,
        "extra_tsc_count": 2.0,
        "fee_per_extra_tsc": 4500.0,
        "grc_platform_annual": 15000.0,
        "pentest_fee": 11500.0,
        "remediation_hours": 120.0
      },
      "expected_baseline_output": 78100.4,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "75-employee SaaS 3-TSC baseline estimate (matches gainhelm_estate.py)",
          "inputs": {
            "cpa_base_fee": 28000.0,
            "extra_tsc_count": 2.0,
            "fee_per_extra_tsc": 4500.0,
            "grc_platform_annual": 15000.0,
            "pentest_fee": 11500.0,
            "remediation_hours": 120.0
          },
          "expected": 78100.4
        },
        {
          "label": "Minimal Type I/II startup scope (1 TSC)",
          "inputs": {
            "cpa_base_fee": 18000.0,
            "extra_tsc_count": 0.0,
            "fee_per_extra_tsc": 4500.0,
            "grc_platform_annual": 10000.0,
            "pentest_fee": 8000.0,
            "remediation_hours": 80.0
          },
          "expected": 45733.6
        }
      ],
      "citation_keys": [
        "bls_oews_15_1212"
      ],
      "allowed_slug_patterns": [
        ".*soc-2.*",
        ".*iso-27001.*"
      ],
