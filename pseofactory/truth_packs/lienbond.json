  "formulas": {
    "bid_bond": {
      "formula_id": "bid_bond",
      "model_name": "Federal / Commercial Bid Bond Penal Sum (FAR 28.101: 5%-20% of Bid)",
      "expression": "round(contract_bid_amount * (min(20.0, max(5.0, penal_sum_pct)) / 100.0), 2)",
      "js_expression": "(Math.round(((contract_bid_amount * (Math.min(20.0, Math.max(5.0, penal_sum_pct)) / 100.0))) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "contract_bid_amount": 500000.0,
        "penal_sum_pct": 20.0
      },
      "expected_baseline_output": 100000.0,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "$500k bid at 20% FAR 28.101 penal sum",
          "inputs": {
            "contract_bid_amount": 500000.0,
            "penal_sum_pct": 20.0
          },
          "expected": 100000.0
        },
        {
          "label": "$1M bid at 5% penal sum floor",
          "inputs": {
            "contract_bid_amount": 1000000.0,
            "penal_sum_pct": 5.0
          },
          "expected": 50000.0
        },
        {
          "label": "Clamped penal sum above 20% caps at 20%",
          "inputs": {
            "contract_bid_amount": 250000.0,
            "penal_sum_pct": 30.0
          },
          "expected": 50000.0
        }
      ],
      "citation_keys": [
        "far_28_101_bid_bond",
        "miller_act_40usc3131"
      ],
      "allowed_slug_patterns": [
        ".*bid-bond.*"
      ],
      "forbidden_slug_patterns": [
        ".*license-bond.*"
      ],
      "output_selectors": [
        "#bid-bond-penal-sum",
        "[data-output='bid_bond_penal_sum']"
      ]
    },
    "contractor_license_bond": {
      "formula_id": "contractor_license_bond",
      "model_name": "Contractor License Surety Bond Annual / Multi-Year Premium",
      "expression": "round(max(min_premium, bond_amount * (min(10.0, max(0.75, rate_pct)) / 100.0) * term_years * (1.0 - multi_year_discount)), 2)",
      "js_expression": "(Math.round((Math.max(min_premium, (((bond_amount * (Math.min(10.0, Math.max(0.75, rate_pct)) / 100.0)) * term_years) * (1.0 - multi_year_discount)))) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "bond_amount": 25000.0,
        "rate_pct": 1.5,
        "term_years": 1,
        "multi_year_discount": 0.0,
        "min_premium": 100.0
      },
      "expected_baseline_output": 375.0,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "CA CSLB $25k bond at 1.5% prime rate",
          "inputs": {
            "bond_amount": 25000.0,
            "rate_pct": 1.5,
            "term_years": 1,
            "multi_year_discount": 0.0,
            "min_premium": 100.0
          },
          "expected": 375.0
        },
        {
          "label": "CA CSLB $25k bond at 6.0% subprime rate",
          "inputs": {
            "bond_amount": 25000.0,
            "rate_pct": 6.0,
            "term_years": 1,
            "multi_year_discount": 0.0,
            "min_premium": 100.0
          },
          "expected": 1500.0
        },
        {
          "label": "Minimum $100 floor on low $10k bond at 0.75%",
          "inputs": {
            "bond_amount": 10000.0,
            "rate_pct": 0.75,
            "term_years": 1,
            "multi_year_discount": 0.0,
            "min_premium": 100.0
          },
          "expected": 100.0
        }
      ],
      "citation_keys": [
        "sfaa_surety_underwriting"
      ],
      "allowed_slug_patterns": [
        ".*license-bond.*"
      ],
      "forbidden_slug_patterns": [
        ".*bid-bond.*"
      ],
      "output_selectors": [
        "#license-bond-premium",
        "[data-output='license_bond_premium']"
      ]
    },
    "ncci_workers_comp_premium": {
      "formula_id": "ncci_workers_comp_premium",
      "model_name": "NCCI Workers Compensation Manual & EMR Net Premium",
      "expression": "round((annual_payroll / 100.0) * class_rate * emr_factor * (1.0 - schedule_credit), 2)",
      "js_expression": "(Math.round((((((annual_payroll / 100.0) * class_rate) * emr_factor) * (1.0 - schedule_credit))) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "annual_payroll": 500000.0,
        "class_rate": 6.4,
        "emr_factor": 1.15,
        "schedule_credit": 0.0
      },
      "expected_baseline_output": 36800.0,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "$500k payroll, 6.40 class rate, 1.15 EMR",
          "inputs": {
            "annual_payroll": 500000.0,
            "class_rate": 6.4,
            "emr_factor": 1.15,
            "schedule_credit": 0.0
          },
          "expected": 36800.0
        },
        {
          "label": "$500k payroll, 6.40 class rate, 0.85 EMR credit + 10% schedule credit",
          "inputs": {
            "annual_payroll": 500000.0,
            "class_rate": 6.4,
            "emr_factor": 0.85,
            "schedule_credit": 0.1
          },
          "expected": 24480.0
        }
      ],
      "citation_keys": [
        "ncci_emr_manual"
      ],
      "allowed_slug_patterns": [
        ".*workers-comp.*",
        ".*emr.*",
        ".*class-code.*"
      ],
      "forbidden_slug_patterns": [],
      "output_selectors": [
        "#net-wc-premium",
        "[data-output='net_wc_premium']"
      ]
    },
    "davis_bacon_overtime_hourly": {
      "formula_id": "davis_bacon_overtime_hourly",
      "model_name": "Davis-Bacon Act (40 U.S.C. 3141 / 29 CFR 5.5) Overtime Hourly Rate",
      "expression": "round((base_prevailing_rate * 1.5) + max(0.0, required_fringe_rate - bona_fide_benefit_credit), 2)",
      "js_expression": "(Math.round((((base_prevailing_rate * 1.5) + Math.max(0.0, (required_fringe_rate - bona_fide_benefit_credit)))) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "base_prevailing_rate": 42.0,
        "required_fringe_rate": 16.5,
        "bona_fide_benefit_credit": 6.5
      },
      "expected_baseline_output": 73.0,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "$42 base + $10 net cash fringe on OT",
          "inputs": {
            "base_prevailing_rate": 42.0,
            "required_fringe_rate": 16.5,
            "bona_fide_benefit_credit": 6.5
          },
          "expected": 73.0
        },
        {
          "label": "Full bona fide benefit credit (no excess fringe cash)",
          "inputs": {
            "base_prevailing_rate": 42.0,
            "required_fringe_rate": 16.5,
            "bona_fide_benefit_credit": 18.0
          },
          "expected": 63.0
        }
      ],
      "citation_keys": [
        "davis_bacon_wh347"
      ],
      "allowed_slug_patterns": [
        ".*davis-bacon.*",
        ".*prevailing-wage.*",
        ".*wh-?347.*"
      ],
      "forbidden_slug_patterns": [],
      "output_selectors": [
        "#davis-bacon-ot-rate",
        "[data-output='ot_hourly_rate']"
      ]
    }
  },
