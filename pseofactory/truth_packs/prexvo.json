  "entries": {
    "hhs_poverty_2026_1person": {
      "key": "hhs_poverty_2026_1person",
      "value": 15960.0,
      "claim_class": "enacted_law",
      "unit": "usd",
      "effective_year": 2026,
      "citation": "91 FR 1797 (2026 HHS Poverty Guidelines, 48 Contiguous States and D.C.)",
      "primary_source_url": "https://www.federalregister.gov/d/2026-00690",
      "publisher": "U.S. Department of Health and Human Services",
      "verified_at": "2026-11-24",
      "expires_at": "2027-02-15",
      "verbatim_quote": "For the 48 contiguous states and the District of Columbia in 2026, the federal poverty guideline for a 1-person family/household is $15,960.",
      "source_quote_sha256": "94181f1b6c947ffbf7d9317707fb2b9d08df9daff3629a04338563dff5654434",
      "superseded_values": [
        {
          "value": 15650.0,
          "label": "2025 HHS 1-person poverty guideline ($15,650)",
          "reason": "Superseded for 2026 by 91 FR 1797 ($15,960).",
          "patterns": [
            "\\$?15,650"
          ]
        },
        {
          "value": 16120.0,
          "label": "Erroneous 2026 poverty guideline figure ($16,120)",
          "reason": "Incorrect figure; official 2026 HHS 1-person contiguous guideline is $15,960.",
          "patterns": [
            "\\$?16,120"
          ]
        }
      ],
      "required_qualifier_patterns": [],
      "applies_to_slugs": [],
      "forbidden_on_slugs": []
    },
