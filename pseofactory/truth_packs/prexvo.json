  "formulas": {
    "rap_monthly_payment": {
      "formula_id": "rap_monthly_payment",
      "model_name": "P.L. 119-21 Section 82001 Repayment Assistance Plan (RAP) Monthly Payment",
      "expression": "round(max(10.0, (agi * (0.01 if agi <= 20000 else (0.02 if agi <= 30000 else (0.03 if agi <= 40000 else (0.04 if agi <= 50000 else (0.05 if agi <= 60000 else (0.06 if agi <= 70000 else (0.07 if agi <= 80000 else (0.08 if agi <= 90000 else (0.09 if agi <= 100000 else 0.10))))))))) / 12.0) - dependents * 50.0) if agi > 10000 else 10.0, 2)",
      "js_expression": "(Math.round((((agi > 10000) ? Math.max(10.0, (((agi * ((agi <= 20000) ? 0.01 : ((agi <= 30000) ? 0.02 : ((agi <= 40000) ? 0.03 : ((agi <= 50000) ? 0.04 : ((agi <= 60000) ? 0.05 : ((agi <= 70000) ? 0.06 : ((agi <= 80000) ? 0.07 : ((agi <= 90000) ? 0.08 : ((agi <= 100000) ? 0.09 : 0.1)))))))))) / 12.0) - (dependents * 50.0))) : 10.0)) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "agi": 65000.0,
        "dependents": 0
      },
      "expected_baseline_output": 325.0,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "$65k AGI, 0 dependents (6% tier)",
          "inputs": {
            "agi": 65000.0,
            "dependents": 0
          },
          "expected": 325.0
        },
        {
          "label": "$65k AGI, 2 dependents ($100 reduction)",
          "inputs": {
            "agi": 65000.0,
            "dependents": 2
          },
          "expected": 225.0
        },
        {
          "label": "$9,500 AGI ($10 statutory floor)",
          "inputs": {
            "agi": 9500.0,
            "dependents": 0
          },
          "expected": 10.0
        },
        {
          "label": "$115k AGI, 0 dependents (10% top tier)",
          "inputs": {
            "agi": 115000.0,
            "dependents": 0
          },
          "expected": 958.33
        }
      ],
      "citation_keys": [
        "pl_119_21_rap"
      ],
      "allowed_slug_patterns": [
        ".*rap.*"
      ],
      "forbidden_slug_patterns": [],
      "output_selectors": [
        "#rap-monthly-payment",
        "[data-output='rap_monthly_payment']"
      ]
    },
    "ibr_monthly_payment": {
      "formula_id": "ibr_monthly_payment",
      "model_name": "2026 Income-Based Repayment (IBR) Monthly Payment (91 FR 1797 FPL)",
      "expression": "round(min(std_10yr_cap, max(0.0, (agi - 1.5 * (15960.0 + 5680.0 * max(0, family_size - 1))) * rate / 12.0)), 2)",
      "js_expression": "(Math.round((Math.min(std_10yr_cap, Math.max(0.0, (((agi - (1.5 * (15960.0 + (5680.0 * Math.max(0, (family_size - 1)))))) * rate) / 12.0)))) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "agi": 65000.0,
        "family_size": 1,
        "rate": 0.1,
        "std_10yr_cap": 681.29
      },
      "expected_baseline_output": 342.17,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "New IBR (10%), $65k AGI, 1-person 2026 FPL",
          "inputs": {
            "agi": 65000.0,
            "family_size": 1,
            "rate": 0.1,
            "std_10yr_cap": 681.29
          },
          "expected": 342.17
        },
        {
          "label": "Legacy IBR (15%), $65k AGI, family of 3",
          "inputs": {
            "agi": 65000.0,
            "family_size": 3,
            "rate": 0.15,
            "std_10yr_cap": 681.29
          },
          "expected": 300.25
        },
        {
          "label": "High earner capped at 10-year standard",
          "inputs": {
            "agi": 160000.0,
            "family_size": 1,
            "rate": 0.1,
            "std_10yr_cap": 681.29
          },
          "expected": 681.29
        }
      ],
      "citation_keys": [
        "hhs_fpl_2026",
        "cfr_34_685_221_ibr"
      ],
      "allowed_slug_patterns": [
        ".*ibr.*",
        ".*rap-vs-ibr.*"
      ],
      "forbidden_slug_patterns": [],
      "output_selectors": [
        "#ibr-monthly-payment",
        "[data-output='ibr_monthly_payment']"
      ]
    },
    "pslf_total_out_of_pocket_and_forgiveness": {
      "formula_id": "pslf_total_out_of_pocket_and_forgiveness",
      "model_name": "PSLF Remaining 120-Payment Forgiveness Estimate (34 CFR 685.219)",
      "expression": "round(max(0.0, principal * pow(1.0 + annual_rate / 12.0, max(0, 120 - certified_payments)) - monthly_idr_payment * ((pow(1.0 + annual_rate / 12.0, max(0, 120 - certified_payments)) - 1.0) / (annual_rate / 12.0))), 2)",
      "js_expression": "(Math.round((Math.max(0.0, ((principal * Math.pow((1.0 + (annual_rate / 12.0)), Math.max(0, (120 - certified_payments)))) - (monthly_idr_payment * ((Math.pow((1.0 + (annual_rate / 12.0)), Math.max(0, (120 - certified_payments))) - 1.0) / (annual_rate / 12.0)))))) * Math.pow(10, 2)) / Math.pow(10, 2))",
      "variables": {
        "principal": 65000.0,
        "annual_rate": 0.065,
        "certified_payments": 24,
        "monthly_idr_payment": 250.0
      },
      "expected_baseline_output": 77809.15,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "$65k principal, 24 certified payments, $250/mo IDR",
          "inputs": {
            "principal": 65000.0,
            "annual_rate": 0.065,
            "certified_payments": 24,
            "monthly_idr_payment": 250.0
          },
          "expected": 77809.15
        },
        {
          "label": "120 payments already certified",
          "inputs": {
            "principal": 40000.0,
            "annual_rate": 0.06,
            "certified_payments": 120,
            "monthly_idr_payment": 200.0
          },
          "expected": 40000.0
        }
      ],
      "citation_keys": [
        "cfr_34_685_219_pslf"
      ],
      "allowed_slug_patterns": [
        ".*pslf.*"
      ],
      "forbidden_slug_patterns": [],
      "output_selectors": [
        "#pslf-forgiven-balance",
        "[data-output='pslf_forgiven_balance']"
      ]
    },
    "refinance_breakeven_months": {
      "formula_id": "refinance_breakeven_months",
      "model_name": "Private Student Loan Refinance Break-Even Months",
      "expression": "round(closing_fees / (current_monthly_payment - new_monthly_payment), 1) if current_monthly_payment > new_monthly_payment else 999.0",
      "js_expression": "((current_monthly_payment > new_monthly_payment) ? (Math.round(((closing_fees / (current_monthly_payment - new_monthly_payment))) * Math.pow(10, 1)) / Math.pow(10, 1)) : 999.0)",
      "variables": {
        "closing_fees": 990.0,
        "current_monthly_payment": 681.29,
        "new_monthly_payment": 598.79
      },
      "expected_baseline_output": 12.0,
      "tolerance": 0.01,
      "test_vectors": [
        {
          "label": "$990 fee with $82.50/mo savings -> 12.0 months",
          "inputs": {
            "closing_fees": 990.0,
            "current_monthly_payment": 681.29,
            "new_monthly_payment": 598.79
          },
          "expected": 12.0
        },
        {
          "label": "Zero closing fees -> 0.0 months",
          "inputs": {
            "closing_fees": 0.0,
            "current_monthly_payment": 681.29,
            "new_monthly_payment": 598.79
          },
          "expected": 0.0
        },
        {
          "label": "Higher new payment (no break-even)",
          "inputs": {
            "closing_fees": 500.0,
            "current_monthly_payment": 500.0,
            "new_monthly_payment": 550.0
          },
          "expected": 999.0
        }
      ],
      "citation_keys": [
        "tila_12_cfr_1026"
      ],
      "allowed_slug_patterns": [
        ".*refinance.*"
      ],
      "forbidden_slug_patterns": [],
      "output_selectors": [
        "#refinance-breakeven-months",
        "[data-output='breakeven_months']"
      ]
    }
  },
