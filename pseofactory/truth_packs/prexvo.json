      "citation": "91 FR 1797 (2026 HHS Poverty Guidelines, Per Additional Person)",
      "primary_source_url": "https://www.federalregister.gov/d/2026-00690",
      "publisher": "U.S. Department of Health and Human Services",
      "verified_at": "2026-11-24",
      "expires_at": "2027-02-15",
      "verbatim_quote": "For families/households with more than 1 person in the 48 contiguous states and D.C. in 2026, add $5,680 for each additional person.",
