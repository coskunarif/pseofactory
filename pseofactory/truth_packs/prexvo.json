    "rap_forgiveness_months": {
      "key": "rap_forgiveness_months",
      "value": 360,
      "claim_class": "enacted_law",
      "unit": "months",
      "effective_year": 2026,
      "citation": "P.L. 119-21 Section 82001 (Repayment Assistance Plan)",
      "primary_source_url": "https://studentaid.gov/idr/",
      "publisher": "U.S. Department of Education",
      "verified_at": "2026-11-24",
      "expires_at": "2027-11-15",
      "verbatim_quote": "Under the Repayment Assistance Plan (RAP) enacted in P.L. 119-21 Section 82001, remaining loan balance forgiveness occurs after 360 qualifying monthly payments (30 years).",
